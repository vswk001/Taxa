{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Taxa",
  "version": "0.4.1",
  "identifier": "com.taxa.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Taxa",
        "width": 1200,
        "height": 800
      },
      {
        "label": "quick-capture",
        "title": "Taxa Quick Capture",
        "url": "index.html#quick-capture",
        "width": 560,
        "height": 260,
        "decorations": false,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "center": true,
        "resizable": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https: http: asset: http://asset.localhost",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost"
      },
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/Taxa/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYzMzgwQjQ2NEExQ0JDMzMKUldRenZCeEtSZ3M0ODRzcjFiOWdxUG8yVlE2SWlzbGQveGJiMVo1Z3o2OStxc0hZbVhnamNvVnQK",
      "endpoints": [
        "https://github.com/vswk001/Taxa/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
